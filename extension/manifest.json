{
  "manifest_version": 3,
  "name": "DownKit 助手",
  "version": "1.0.8",
  "key": "",
  "description": "检测当前页面的 HLS、DASH、MP4 和分离媒体轨，并交给 DownKit 下载。",
  "permissions": [
    "storage",
    "tabs",
    "webRequest",
    "cookies",
    "nativeMessaging",
    "sidePanel"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content/detector.js"],
      "run_at": "document_start",
      "all_frames": false
    }
  ],
  "action": {
    "default_title": "DownKit 助手",
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  },
  "side_panel": {
    "default_path": "popup/popup.html"
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  }
}
